#!/usr/bin/env python3
from __future__ import annotations
import sys, os, subprocess, json, urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))

def _load_env():
    ef = ROOT / '.env'
    if ef.exists():
        for ln in ef.read_text().splitlines():
            ln = ln.strip()
            if ln and not ln.startswith('#') and '=' in ln:
                k, v = ln.split('=', 1)
                os.environ.setdefault(k.strip(), v.strip().strip('"').strip("'"))

_load_env()
cmd = sys.argv[1] if len(sys.argv) > 1 else 'run'

if cmd == 'test':
    res = subprocess.run(['node', str(ROOT / 'tests' / 'run-tests.js')])
    sys.exit(res.returncode)

if cmd in ('validate-models', 'live-norel'):
    from agent_kit import settings
    probe = settings.probe_live_inference()
    report = {
        'reasoning_meta_api': {
            'configured_model': settings.MODEL_ROLES['reasoning'],
            'live_verified': False,
            'mode': 'DETERMINISTIC_FALLBACK_SIMULATION',
            'note': 'Direct api.meta.ai key not active; reasoning loop uses deterministic verifier or Fireworks Muse Glimmer 30B.'
        },
        'fireworks_muse_glimmer_30b': {
            'fine_tuned_deployment': settings.FIREWORKS_DEPLOYED_MODEL,
            'base_model': settings.FIREWORKS_BASE_MODEL,
            'active_model_used': probe['active_model'],
            'live_verified': probe['live'],
            'mode': probe['mode'],
            'sample_response': probe['response'],
            'usage': probe['usage']
        }
    }
    print(json.dumps(report, indent=2))
    sys.exit(0)

if cmd == 'resume':
    sig = ' '.join(sys.argv[2:]) or 'Dispatcher-Willie-Harvey-Verified'
    from legal_agent.loop import resume_run
    resume_run(ROOT, 'run_latest', dispatcher_signature=sig)
    sys.exit(0)

case_name = None
prompt = None
args = sys.argv[2:]
i = 0
while i < len(args):
    if args[i] == '--case' and i + 1 < len(args):
        case_name = args[i + 1]; i += 2
    elif args[i] == '--prompt' and i + 1 < len(args):
        prompt = args[i + 1]; i += 2
    elif args[i] == '--turns' and i + 1 < len(args):
        i += 2
    else:
        i += 1
from legal_agent.loop import run_agent
run_agent(ROOT, objective=prompt, case_name=case_name)
