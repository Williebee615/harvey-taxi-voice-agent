#!/usr/bin/env python3
from __future__ import annotations
import sys, os, subprocess, json, urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))

def _load_env():
    ef = ROOT / '.env'
    if ef.exists():
        for ln in ef.read_text().splitlines():
            ln = ln.strip()
            if ln and not ln.startswith('#') and '=' in ln:
                k, v = ln.split('=', 1)
                os.environ.setdefault(k.strip(), v.strip().strip('"').strip("'"))

_load_env()
cmd = sys.argv[1] if len(sys.argv) > 1 else 'run'

if cmd == 'test':
    res = subprocess.run(['node', str(ROOT / 'tests' / 'run-tests.js')])
    sys.exit(res.returncode)

if cmd in ('validate-models', 'live-norel'):
    from agent_kit import settings
    report = {
        'reasoning_meta_api': {'model': settings.MODEL_ROLES['reasoning'], 'live_verified': False, 'mode': 'DETERMINISTIC_FALLBACK_SIMULATION'},
        'fine_tuned_fireworks': {'model': settings.FIREWORKS_DEPLOYED_MODEL, 'live_verified': False, 'mode': 'DETERMINISTIC_FALLBACK_SIMULATION'}
    }
    meta_key = os.environ.get('META_API_KEY') or os.environ.get('MODEL_API_KEY')
    if meta_key:
        try:
            req = urllib.request.Request('[https://api.meta.ai/v1/models](https://api.meta.ai/v1/models)', headers={'Authorization': f'Bearer {meta_key}'})
            with urllib.request.urlopen(req, timeout=8) as r:
                if r.status == 200:
                    report['reasoning_meta_api']['live_verified'] = True
                    report['reasoning_meta_api']['mode'] = 'LIVE_META_API'
        except Exception as e:
            report['reasoning_meta_api']['error'] = str(e)
    fw_key = os.environ.get('FIREWORKS_API_KEY')
    if fw_key:
        payload = json.dumps({
            'model': settings.FIREWORKS_DEPLOYED_MODEL,
            'messages': [
                {'role': 'system', 'content': 'You are the Harvey Taxi ADA Fare Verifier.'},
                {'role': 'user', 'content': 'Compute Harvey Taxi fare for 6.0 miles ($2.50 base + $1.50/mi, $0 ADA fee).'}
            ],
            'max_tokens': 80,
            'temperature': 0.0
        }).encode('utf-8')
        req = urllib.request.Request(
            '[https://api.fireworks.ai/inference/v1/chat/completions](https://api.fireworks.ai/inference/v1/chat/completions)',
            data=payload,
            headers={'Authorization': f'Bearer {fw_key}', 'Content-Type': 'application/json', 'User-Agent': 'HarveyTaxi-Verifier/1.0'}
        )
        try:
            with urllib.request.urlopen(req, timeout=15) as r:
                data = json.loads(r.read().decode('utf-8'))
                report['fine_tuned_fireworks']['live_verified'] = True
                report['fine_tuned_fireworks']['mode'] = 'LIVE_FIREWORKS_GPU'
                report['fine_tuned_fireworks']['sample_response'] = data['choices'][0]['message']['content'].strip()
                report['fine_tuned_fireworks']['usage'] = data.get('usage', {})
        except Exception as e:
            report['fine_tuned_fireworks']['error'] = str(e)
    print(json.dumps(report, indent=2))
    sys.exit(0)

if cmd == 'resume':
    sig = ' '.join(sys.argv[2:]) or 'Dispatcher-Willie-Harvey-Verified'
    from legal_agent.loop import resume_run
    resume_run(ROOT, 'run_latest', dispatcher_signature=sig)
    sys.exit(0)

case_name = None
prompt = None
args = sys.argv[2:]
i = 0
while i < len(args):
    if args[i] == '--case' and i + 1 < len(args):
        case_name = args[i + 1]; i += 2
    elif args[i] == '--prompt' and i + 1 < len(args):
        prompt = args[i + 1]; i += 2
    elif args[i] == '--turns' and i + 1 < len(args):
        i += 2
    else:
        i += 1
from legal_agent.loop import run_agent
run_agent(ROOT, objective=prompt, case_name=case_name)
