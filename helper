#!/usr/bin/env python3
"""Harvey Taxi developer CLI. Secrets are loaded locally, never printed."""
import argparse
import json
import subprocess
import sys
from pathlib import Path
ROOT = Path(__file__).resolve().parent
sys.path.insert(0, str(ROOT))
from agent_kit import progress, settings
from harvey_agent.loop import approve_run, resume_run, run_agent


def main():
    parser = argparse.ArgumentParser(description='Harvey Taxi verifiable agent. Live mode sends case evidence to Meta; simulation makes no API calls.')
    subs = parser.add_subparsers(dest='command', required=True)
    run = subs.add_parser('run', help='Start a new evidence review')
    run.add_argument('--case', default='harvey-taxi-ada-doctor-visit')
    run.add_argument('--mode', choices=['simulation', 'live'], default='simulation')
    run.add_argument('--turns', type=int, default=20)
    run.add_argument('--prompt')
    spoken = run.add_mutually_exclusive_group()
    spoken.add_argument('--spoken-request', help='Rider request transcript, added to the run as untrusted evidence')
    spoken.add_argument('--spoken-audio', help='WAV recording transcribed by Meta Muse Voice Transcribe (one paid call), then added as untrusted evidence')
    resume = subs.add_parser('resume', help='Continue a paused run or supply a follow-up')
    resume.add_argument('--run-id', default='run_latest')
    resume.add_argument('--message', default='')
    resume.add_argument('--turns', type=int, default=20)
    approve = subs.add_parser('approve', help='Record demo human signoff; never dispatches')
    approve.add_argument('--run-id', required=True)
    approve.add_argument('--signature', required=True)
    show = subs.add_parser('show', help='Inspect the public audit record')
    show.add_argument('--run-id', default='run_latest')
    subs.add_parser('validate-models', help='Make one Meta API probe (separate from booking runs)')
    probe = subs.add_parser('probe', help='List Meta models and test image input (at most one paid call)')
    probe.add_argument('--no-image', action='store_true', help='Only list models; no inference call')
    subs.add_parser('probe-speech', help='Transcribe the fictional demo recording with Meta (exactly one paid call)')
    subs.add_parser('test', help='Run offline regression tests; no keys or API calls required')
    serve = subs.add_parser('serve', help='Open the local agent console server')
    serve.add_argument('--port', type=int, default=8765)
    args = parser.parse_args()
    settings.load_env(ROOT)
    try:
        if args.command == 'test':
            return subprocess.call([sys.executable, '-m', 'unittest', 'discover', '-s', 'tests', '-p', 'test_*.py', '-v'], cwd=ROOT)
        if args.command == 'serve':
            from ui.ui import main as serve_console
            serve_console(args.port)
            return 0
        if args.command == 'run':
            spoken, source = args.spoken_request, None
            if args.spoken_audio:
                from agent_kit import speech
                heard = speech.transcribe(Path(args.spoken_audio).read_bytes())
                spoken = heard['transcript']
                source = {k: heard[k] for k in ('model', 'session_id', 'audio_duration_ms', 'latency_ms', 'billed_seconds_estimate', 'cost_usd_estimate')}
            result = run_agent(ROOT, args.turns, args.prompt, args.case, args.mode, spoken_request=spoken, speech_source=source)
        elif args.command == 'resume':
            result = resume_run(ROOT, args.run_id, message=args.message, turns=args.turns)
        elif args.command == 'approve':
            result = approve_run(ROOT, args.run_id, args.signature)
        elif args.command == 'probe':
            from agent_kit import probe
            print(json.dumps(probe.run(ROOT, image=not args.no_image), indent=2))
            return 0
        elif args.command == 'probe-speech':
            from agent_kit import speech
            print(json.dumps(speech.speech_probe(ROOT), indent=2))
            return 0
        elif args.command == 'show':
            result = progress.load_progress(ROOT, args.run_id)
        else:
            result = settings.probe_live_inference()
        print(json.dumps(progress.public_record(result), indent=2))
        return 2 if result.get('status') == 'paused' and result.get('turns', [{}])[-1].get('tool') == 'api_error' else 0
    except (ValueError, OSError, RuntimeError) as error:
        print(f'Error: {error}', file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
